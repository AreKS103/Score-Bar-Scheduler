/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next_old*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
